; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="B1T JAM"
run/main_scene="uid://c28ase7v02cer"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*uid://dxldot4rwiqjc"
Dialogic="*uid://ds2q0uclmolvu"
ThemeGlobal="*uid://g3l8kfmt2sbw"

[dialogic]

directories/dch_directory={
"Bob": "res://Characters/Bob.dch",
"GRED": "res://Characters/GRED.dch",
"GUYINTHECLOSET": "res://Characters/GUYINTHECLOSET.dch",
"JENNY THE BOSS": "res://Characters/JENNY THE BOSS.dch",
"Thomas": "res://Characters/Thomas.dch",
"Tom": "res://Characters/Tom.dch",
"YOU": "res://Characters/YOU.dch"
}
directories/dtl_directory={
"BOB": "res://chats/BOB.dtl",
"CHEST-1": "res://chats/CHEST-1.dtl",
"CLOSETGUY": "res://chats/CLOSETGUY.dtl",
"Friend1": "res://chats/Friend1.dtl",
"JENNY": "res://chats/JENNY.dtl",
"Thomas": "res://chats/Thomas.dtl",
"comp1": "res://chats/Computers/comp1.dtl",
"no key": "res://chats/no key.dtl",
"timeline": "res://chats/Computers/timeline.dtl"
}
layout/style_directory={
"": "res://ChAT STYLES/New_File.tres",
"New_File": "res://ChAT STYLES/New_File.tres",
"buubble": "res://chats/buubble.tres",
"style": "res://chats/style.tres"
}
layout/style_list=["res://ChAT STYLES/New_File.tres", "res://chats/style.tres", "res://chats/buubble.tres"]
layout/default_style="res://ChAT STYLES/New_File.tres"
glossary/default_case_sensitive=true
variables={
"Chestopened": false,
"NewFolder": {
"NewVar": ""
},
"ThomasSp": false,
"bobchat": false,
"item": "",
"spoken": false,
"spoken2guy2": false
}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

